# PayPal REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API=https://api-m.sandbox.paypal.com
# Webhook id from the app's webhook settings; needed to verify webhook signatures
PAYPAL_WEBHOOK_ID=

# AI explanations. Any OpenAI-compatible chat endpoint works; Gemini's free tier is the default.
# Leave AI_API_KEY empty to run with rule-based explanations only.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL=gemini-3.1-flash-lite

# Payments at or above this amount from a stranger are treated as large (USD)
LARGE_PAYMENT=200
PORT=8787
# Hold Up has no login, so it listens on localhost only. HOST=0.0.0.0 is allowed with DEMO=1 (e.g. for hosting).
HOST=127.0.0.1
DB_PATH=holdup.db
# DEMO=1 loads sample payments instead of calling PayPal (no keys needed)
DEMO=
